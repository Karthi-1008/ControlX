<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tv_bg"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_rom_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/accent_indigo"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_refresh"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/refresh_roms"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_remap"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/remap_controls"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:focusable="true"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_folder"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="📁 Choose Folder / File"
                android:backgroundTint="@color/accent_blue"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Connected Controller Toast / Banner -->
    <TextView
        android:id="@+id/tv_controller_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_green"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- Current Directory label -->
    <TextView
        android:id="@+id/tv_current_dir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ROMs: /storage/emulated/0/GBA_ROMS"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="6dp" />

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/empty_state_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁"
            android:textSize="54sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_roms_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tv_empty_desc"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:text="@string/no_roms_desc"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btn_empty_browse"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="📁 Choose Game / Folder"
                android:backgroundTint="@color/accent_blue"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_empty_refresh"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="🔄 Rescan /GBA_ROMS/"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Grid View for ROMs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_roms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:focusable="true" />

</LinearLayout>
