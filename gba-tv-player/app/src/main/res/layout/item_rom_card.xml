<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:background="@drawable/card_focus_bg"
    android:padding="16dp"
    android:layout_margin="8dp">

    <!-- Cartridge Header Accent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#1E2436"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/card_game_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGB-GBA"
            android:textColor="@color/accent_indigo"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_icon_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮"
            android:textSize="26sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Game Title -->
    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="10dp" />

    <!-- File details -->
    <TextView
        android:id="@+id/card_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
